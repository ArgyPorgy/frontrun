# Paste each key straight after its = sign, with no spaces and no quotes.
# Then run `pnpm keys:check`, which tests them and never prints their values.
# Everything here is server-only unless it starts with NEXT_PUBLIC_.

# =============================================================================================
# STEP 1: data and quotes. These can't move money, so they're safe to add first.
# =============================================================================================

# Free Demo key: coingecko.com/en/api/pricing > Create Demo Account > Developer Dashboard.
# 100 calls a minute, against about 5 with no key. Without one, charts and lists lag badly.
COINGECKO_API_KEY=
# demo for a free key, pro for a paid one.
COINGECKO_PLAN=demo

# Your own key: app.definitive.fi > More > Flash > Create Flash Key.
# Without it, Flash is off and cross-chain trades use LI.FI only.
FLASH_API_KEY=

# developers.uniswap.org/dashboard. Without it, Arc swaps use the direct v3 route.
UNISWAP_API_KEY=

# =============================================================================================
# STEP 2: real Google login. Fills stay simulated, so this still can't move money.
# =============================================================================================

# dashboard.privy.io > your app > App settings. Also turn on Google under Login methods,
# and add http://localhost:3000 to the allowed domains.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Change to privy once the two values above are in.
AUTH_MODE=dev

# =============================================================================================
# STEP 3: one-tap signing. The app can sign for users within limits, so treat these as sensitive.
# =============================================================================================

# Dashboard > Wallet infrastructure > Authorization keys > Create new key.
# It's only shown once. Keep it in a KMS for production.
PRIVY_AUTHORIZATION_KEY=
PRIVY_SIGNER_ID=

# Run `pnpm privy:policy` after the keys above are in, and paste the two ids it prints.
# With no EVM policy, one-tap stays off. With no Solana policy, Solana sells ask for a confirm.
PRIVY_POLICY_IDS=
PRIVY_SOLANA_POLICY_IDS=

# =============================================================================================
# STEP 4: real money. Leave as paper until you've read docs/GO_LIVE.md.
# =============================================================================================

TRADING_MODE=paper

# Funds small native top-ups when Privy can't sponsor a first sell's approval. Empty disables it.
GAS_TOPUP_PRIVATE_KEY=

# ThesisRegistry on Arc: deploy with `pnpm registry:deploy`. While empty, theses aren't anchored.
THESIS_REGISTRY_ADDRESS=
# Pays to anchor theses, and must be the contract's relayer. Empty means the gas wallet above.
ANCHOR_RELAYER_PRIVATE_KEY=

# =============================================================================================
# Optional
# =============================================================================================

# Optional: skips a network call on every token check (Dashboard > Configuration > App settings).
PRIVY_JWT_VERIFICATION_KEY=

# Charged on Flash trades, in basis points. 0 means the app charges nothing.
FLASH_INTEGRATOR_FEE_BPS=0

LIFI_API_KEY=
LIFI_INTEGRATOR=frontrun

# Alchemy or QuickNode for production. The public Arc endpoint is fine for now.
ARC_RPC_URL=https://rpc.mainnet.arc.io
ROBINHOOD_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
ETHEREUM_RPC_URL=
BSC_RPC_URL=
HYPEREVM_RPC_URL=
SOLANA_RPC_URL=

# Turns on the X tracker. From twitterapi.io, billed per post read.
TWITTERAPI_IO_KEY=
# Seconds between X tracker requests. Lower is fresher and costs more.
X_TRACKER_INTERVAL_SECONDS=20

# The app's fee on every trade, in basis points. 50 is 0.5%.
FLASH_INTEGRATOR_FEE_BPS=50
# Receives the fee on Uniswap trades. Flash pays its fee into your Definitive account.
FEE_RECIPIENT_ADDRESS=
# Set to 0.005 once a fee wallet is set up at portal.li.fi. Until then LI.FI is only a last resort.
LIFI_FEE=

# Makes trading gasless for users: Pimlico pays gas on every EVM chain except HyperEVM.
PIMLICO_API_KEY=
PIMLICO_SPONSORSHIP_POLICY_ID=

# Generate with: pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Use a real contact address before launch.
VAPID_SUBJECT=mailto:hello@example.com

GEO_BLOCKED_COUNTRIES=CU,IR,KP,SY,RU,BY
# Enables GET /internal/metrics.
ADMIN_TOKEN=

# =============================================================================================
# Local setup. Nothing to change here.
# =============================================================================================

NODE_ENV=development
APP_ORIGIN=http://localhost:3000
API_PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://localhost:5432/frontrun_dev
# In production, use a hosted Postgres's direct connection, not a pooled one, with sslmode=verify-full.
REDIS_URL=redis://localhost:6379
DEV_JWT_SECRET=change-me-to-any-long-random-string
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional. Used in the browser, so anyone can read it: never reuse a private SOLANA_RPC_URL here.
# Leave empty to use Solana's public endpoint, or set a key locked to your domain.
NEXT_PUBLIC_SOLANA_RPC_URL=
